<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature
        android:name="android.software.ipsec_tunnels"
        android:required="false" />

    <application
        android:name=".Ikev2VpnApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_vpn"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_vpn"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ikev2Vpn"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.VpnEventService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.action.VPN_MANAGER_EVENT" />
                <category android:name="android.net.category.EVENT_ALWAYS_ON_STATE_CHANGED" />
                <category android:name="android.net.category.EVENT_DEACTIVATED_BY_USER" />
                <category android:name="android.net.category.EVENT_IKE_ERROR" />
                <category android:name="android.net.category.EVENT_NETWORK_ERROR" />
            </intent-filter>
        </service>
    </application>

</manifest>
