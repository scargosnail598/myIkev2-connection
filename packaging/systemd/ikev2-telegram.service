[Unit]
Description=Private IKEv2 Telegram status bot
Wants=network-online.target ikev2-telegram-collect.timer
After=network-online.target ikev2-telegram-collect.service

[Service]
Type=simple
User=ikev2-telegram
Group=ikev2-telegram
WorkingDirectory=/opt/ikev2-telegram
LoadCredential=telegram-config:/etc/ikev2-telegram/config.json
ExecStart=/usr/bin/python3 -B -m telegram_bot.app run --config ${CREDENTIALS_DIRECTORY}/telegram-config
Restart=on-failure
RestartSec=30
TimeoutStopSec=45
StateDirectory=ikev2-telegram
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ikev2-telegram
InaccessiblePaths=-/run/ikev2-web -/etc/ipsec.secrets -/etc/ipsec.d/private -/etc/ikev2-web -/etc/ikev2-telegram -/var/lib/ikev2-easy-installer -/var/lib/ikev2-web
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
